# Copy to .env (gitignored) and fill in.
# The API auto-loads this file at startup via spring.config.import.

# ---- Assistant backend ----------------------------------------------------
# Pick one. Leave both blank to fall back to a local Ollama on
# CHRONOS_OLLAMA_URL (default http://localhost:11434).
#
# AGENT_MODE = claude | gemini
# AGENT_KEY  = the matching API key
AGENT_MODE=
AGENT_KEY=

# Optional model overrides:
# CHRONOS_CLAUDE_MODEL=claude-opus-4-7
# CHRONOS_GEMINI_MODEL=gemini-2.5-flash
# CHRONOS_OLLAMA_URL=http://localhost:11434
# CHRONOS_OLLAMA_MODEL=qwen2.5:3b

# ---- Database -------------------------------------------------------------
# Defaults match the local-dev Postgres setup (winget install) +
# the chronos / chronos role-and-database created during setup.
# CHRONOS_DB_URL=jdbc:postgresql://localhost:5432/chronos
# CHRONOS_DB_USER=chronos
# CHRONOS_DB_PASSWORD=chronos

# ---- JWT ------------------------------------------------------------------
# Without this, tokens won't survive an API restart (the secret is
# regenerated each boot). Set anything random and stable for shared dev.
# CHRONOS_JWT_SECRET=replace-me

# ---- Google OAuth (production only) --------------------------------------
# Setting CHRONOS_OAUTH_ENABLED=true requires both GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET to be set. Without them the API short-circuits to
# the deterministic local-dev user.
# CHRONOS_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
